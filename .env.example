# ============================================================
# DIRPOLES_IA - Variables de entorno
# Copia este archivo como .env y completa los valores
# ============================================================

# --- Base de Datos Principal (dirpoles_business) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dirpoles_business
DB_USER=root
DB_PASS=tu_contraseña_aqui

# --- Base de Datos de Seguridad (dirpoles_security) ---
DB_SECURITY_NAME=dirpoles_security

# --- Servidor ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# --- Seguridad (API Key compartida con el monolito PHP) ---
IA_API_KEY=genera_una_clave_secreta_aqui

# --- IA (Google AI Studio / Gemini) ---
GEMINI_API_KEY=tu_gemini_api_key_aqui

# --- CORS (orígenes permitidos, separados por coma) ---
ALLOWED_ORIGINS=http://localhost,http://localhost:80
